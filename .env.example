# Copy to .env.local and fill in. Never commit real values.

# MongoDB connection string, including the database name. Sign-up uses
# transactions, so this must be a replica set: MongoDB Atlas (any tier) or a
# local single-node replica set.
MONGODB_URI=mongodb://localhost:27017/jobtracker?replicaSet=rs0

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app.
BETTER_AUTH_URL=http://localhost:3000
